          "title": "Title",
          "type": "string"
        },
        "excerpt": {
          "default": "",
          "maxLength": 1000,
          "title": "Excerpt",
          "type": "string"
        },
        "body": {
          "items": {
            "$ref": "#/$defs/DraftBlock"
