          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ContentTypeCatalog",
      "type": "object"
    },
    "ContentTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "icon": {
          "title": "Icon",
          "type": "string"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "title_required": {
          "title": "Title Required",
          "type": "boolean"
        },
        "supports_excerpt": {
          "title": "Supports Excerpt",
          "type": "boolean"
        },
        "editor": {
          "title": "Editor",
          "type": "string"
        }
      },
      "required": [
        "id",
        "owner",
        "label",
        "description",
        "icon",
        "order",
        "title_required",
        "supports_excerpt",
        "editor"
      ],
      "title": "ContentTypeDefinition",
      "type": "object"
    },
    "DraftBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "markdown",
          "default": "markdown",
          "title": "Type",
          "type": "string"
        },
        "content": {
          "maxLength": 100000,
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "id",
        "content"
      ],
      "title": "DraftBlock",
      "type": "object"
    },
    "DraftCatalog": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/DraftSummary"
          },
          "title": "Items",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "title": "Page Size",
          "type": "integer"
        }
      },
      "required": [
        "items",
        "total",
        "page",
        "page_size"
      ],
