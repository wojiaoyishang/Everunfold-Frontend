          "$ref": "#/$defs/DraftFields"
        }
      },
      "required": [
        "operation_id",
        "type_id",
        "fields"
      ],
      "title": "DraftCreate",
      "type": "object"
    },
    "DraftDetail": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "type_id": {
          "title": "Type Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "preview": {
          "title": "Preview",
          "type": "string"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "enum": [
            "draft",
            "trash"
          ],
          "title": "Status",
          "type": "string"
        },
        "is_demo": {
          "title": "Is Demo",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "body": {
          "items": {
            "$ref": "#/$defs/DraftBlock"
          },
          "title": "Body",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type_id",
        "title",
        "excerpt",
        "preview",
        "author",
        "revision",
        "status",
        "is_demo",
        "created_at",
        "updated_at",
        "body"
