{
  "$defs": {
    "ContentBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "markdown",
            "html"
          ],
          "title": "Type",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "content"
      ],
      "title": "ContentBlock",
      "type": "object"
    },
    "ContentDelivery": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "content-1",
          "default": "content-1",
          "title": "Protocol",
          "type": "string"
        },
        "node_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Node Id",
          "type": "string"
        },
        "source_epoch": {
          "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$",
          "title": "Source Epoch",
          "type": "string"
        },
        "resource": {
          "const": "public-content",
          "default": "public-content",
          "title": "Resource",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "value": {
          "$ref": "#/$defs/PublicSnapshot"
        }
      },
      "required": [
        "node_id",
        "source_epoch",
        "revision",
        "value"
      ],
      "title": "ContentDelivery",
      "type": "object"
    },
    "ContentDetail": {
      "additionalProperties": false,
      "properties": {
        "comments_open": {
          "default": true,
          "title": "Comments Open",
          "type": "boolean"
        },
        "seo_title": {
          "default": "",
          "title": "Seo Title",
          "type": "string"
        },
        "seo_description": {
          "default": "",
          "title": "Seo Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "article",
            "shuoshuo",
            "page"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "cover_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cover Url"
        },
        "reading_minutes": {
          "minimum": 1,
          "title": "Reading Minutes",
          "type": "integer"
        },
        "word_count": {
          "minimum": 0,
          "title": "Word Count",
          "type": "integer"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/TaxonomyDTO"
          },
          "title": "Categories",
          "type": "array"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/TaxonomyDTO"
          },
          "title": "Tags",
          "type": "array"
        },
        "comment_count": {
          "minimum": 0,
          "title": "Comment Count",
          "type": "integer"
        },
        "pinned": {
          "title": "Pinned",
          "type": "boolean"
        },
        "content": {
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "title": "Content",
          "type": "array"
        },
        "media_urls": {
          "additionalProperties": {
            "$ref": "#/$defs/MediaURL"
          },
          "title": "Media Urls",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "path",
        "excerpt",
        "language",
        "published_at",
        "updated_at",
        "author",
        "cover_url",
        "reading_minutes",
        "word_count",
        "categories",
        "tags",
        "comment_count",
        "pinned",
        "content",
        "media_urls"
      ],
      "title": "ContentDetail",
      "type": "object"
    },
    "ContentSyncState": {
      "additionalProperties": false,
      "properties": {
        "source_epoch": {
          "title": "Source Epoch",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "integer"
        },
        "delivery": {
          "items": {
            "$ref": "#/$defs/DeliveryState"
          },
          "title": "Delivery",
          "type": "array"
        }
      },
      "required": [
        "source_epoch",
        "revision",
        "delivery"
      ],
      "title": "ContentSyncState",
      "type": "object"
    },
    "ContentTypeCatalog": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ContentTypeDefinition"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "ContentTypeCatalog",
      "type": "object"
    },
    "ContentTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "icon": {
          "title": "Icon",
          "type": "string"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "title_required": {
          "title": "Title Required",
          "type": "boolean"
        },
        "supports_excerpt": {
          "title": "Supports Excerpt",
          "type": "boolean"
        },
        "editor": {
          "title": "Editor",
          "type": "string"
        },
        "panels": {
          "items": {
            "type": "string"
          },
          "title": "Panels",
          "type": "array"
        }
      },
      "required": [
        "id",
        "owner",
        "label",
        "description",
        "icon",
        "order",
        "title_required",
        "supports_excerpt",
        "editor"
      ],
      "title": "ContentTypeDefinition",
      "type": "object"
    },
    "DeliveryState": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "desired_revision": {
          "title": "Desired Revision",
          "type": "integer"
        },
        "applied_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applied Revision"
        },
        "status": {
          "enum": [
            "not_configured",
            "pending",
            "applied",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "applied_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applied At"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        }
      },
      "required": [
        "node_id",
        "enabled",
        "desired_revision",
        "applied_revision",
        "status",
        "applied_at",
        "error"
      ],
      "title": "DeliveryState",
      "type": "object"
    },
    "DraftBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "default": "markdown",
