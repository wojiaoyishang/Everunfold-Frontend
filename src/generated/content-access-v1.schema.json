{
  "$defs": {
    "ContentAccessInput": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "password": {
          "default": "",
          "maxLength": 200,
          "title": "Password",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ContentAccessInput",
      "type": "object"
    },
    "ContentBlock": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "markdown",
            "html"
          ],
          "title": "Type",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "content"
      ],
      "title": "ContentBlock",
      "type": "object"
    },
    "ContentDetail": {
      "additionalProperties": false,
      "properties": {
        "comments_open": {
          "default": true,
          "title": "Comments Open",
          "type": "boolean"
        },
        "seo_title": {
          "default": "",
          "title": "Seo Title",
          "type": "string"
        },
        "seo_description": {
          "default": "",
          "title": "Seo Description",
          "type": "string"
        },
        "access": {
          "default": "public",
          "enum": [
            "public",
            "password",
            "scheduled"
          ],
          "title": "Access",
          "type": "string"
        },
        "opens_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opens At"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "article",
            "shuoshuo",
            "page"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "cover_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cover Url"
        },
        "reading_minutes": {
          "minimum": 1,
          "title": "Reading Minutes",
          "type": "integer"
        },
        "word_count": {
          "minimum": 0,
          "title": "Word Count",
          "type": "integer"
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/TaxonomyDTO"
          },
          "title": "Categories",
          "type": "array"
        },
        "tags": {
          "items": {
            "$ref": "#/$defs/TaxonomyDTO"
          },
          "title": "Tags",
          "type": "array"
        },
        "comment_count": {
          "minimum": 0,
          "title": "Comment Count",
          "type": "integer"
        },
        "pinned": {
          "title": "Pinned",
          "type": "boolean"
        },
        "content": {
          "items": {
            "$ref": "#/$defs/ContentBlock"
          },
          "title": "Content",
          "type": "array"
        },
        "media_urls": {
          "additionalProperties": {
            "$ref": "#/$defs/MediaURL"
          },
          "title": "Media Urls",
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "path",
        "excerpt",
        "language",
        "published_at",
        "updated_at",
        "author",
        "cover_url",
        "reading_minutes",
        "word_count",
        "categories",
        "tags",
        "comment_count",
        "pinned",
        "content",
        "media_urls"
      ],
      "title": "ContentDetail",
      "type": "object"
    },
    "MediaURL": {
      "additionalProperties": false,
      "properties": {
        "original": {
          "title": "Original",
          "type": "string"
        },
        "webp": {
          "default": "",
          "title": "Webp",
          "type": "string"
        }
      },
      "required": [
        "original"
      ],
      "title": "MediaURL",
      "type": "object"
    },
    "PublicResponse_ContentDetail_": {
      "additionalProperties": false,
      "properties": {
        "success": {
          "default": true,
          "title": "Success",
          "type": "boolean"
        },
        "code": {
          "default": 200,
          "title": "Code",
          "type": "integer"
        },
        "msg": {
          "default": "请求成功",
          "title": "Msg",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ContentDetail"
        }
      },
      "required": [
        "data"
      ],
      "title": "PublicResponse[ContentDetail]",
      "type": "object"
    },
    "TaxonomyDTO": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "category",
            "tag"
          ],
          "title": "Kind",
          "type": "string"
        },
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "kind",
        "count"
      ],
      "title": "TaxonomyDTO",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request": {
      "$ref": "#/$defs/ContentAccessInput"
    },
    "response": {
      "$ref": "#/$defs/PublicResponse_ContentDetail_"
    }
  },
  "required": [
    "request",
    "response"
  ],
  "title": "ContentAccessContract",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "x-everunfold-contract-version": "1.0.0",
  "x-everunfold-operations": [
    {
      "name": "readProtectedContent",
      "path": "/v1/reader/access",
      "method": "POST",
      "input": "request",
      "response": "response",
      "csrf": false,
      "credentials": "omit"
    }
  ]
}
