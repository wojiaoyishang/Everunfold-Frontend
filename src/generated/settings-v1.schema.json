{
  "$defs": {
    "CachePolicy": {
      "additionalProperties": false,
      "description": "First operational policy: request lifetime, refresh freshness and batching.",
      "properties": {
        "dynamic_freshness_seconds": {
          "default": 30,
          "maximum": 3600,
          "minimum": 5,
          "title": "Dynamic Freshness Seconds",
          "type": "integer"
        },
        "request_timeout_seconds": {
          "default": 8,
          "maximum": 30,
          "minimum": 1,
          "title": "Request Timeout Seconds",
          "type": "integer"
        },
        "retry_delay_ms": {
          "default": 1500,
          "maximum": 5000,
          "minimum": 100,
          "title": "Retry Delay Ms",
          "type": "integer"
        },
        "batch_delay_ms": {
          "default": 24,
          "maximum": 250,
          "minimum": 0,
          "title": "Batch Delay Ms",
          "type": "integer"
        }
      },
      "title": "CachePolicy",
      "type": "object"
    },
