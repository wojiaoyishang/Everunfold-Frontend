{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./var/cache/plugins-types.tsbuildinfo",
    "types": ["node", "react", "react-dom", "next/types/global"]
  },
  "include": [
    "src/sdk/plugin-assets.d.ts",
    "src/plugins/**/*.ts",
    "src/plugins/**/*.tsx"
