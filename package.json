{
  "name": "everunfold-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Everunfold 的独立 Next.js 前端项目",
  "engines": {
    "node": ">=22.15.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "failure:generate": "tsx tools/generate-failure-pages.mts",
    "failure:check": "tsx tools/generate-failure-pages.mts --check",
    "predev": "npm run failure:generate",
    "prebuild": "npm run failure:generate",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "verify:production": "node tools/verify-production.mjs",
    "verify:admin": "node tools/verify-production.mjs --admin",
    "verify:reader": "node tools/verify-production.mjs --reader",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests tools .github next.config.ts eslint.config.mjs package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src tests tools .github next.config.ts eslint.config.mjs package.json tsconfig.json .prettierrc.json",
    "check": "npm run failure:check && npm run lint && npm run typecheck && npm run format:check && npm run test",
    "contract:sync": "node tools/sync-contract.mjs",
    "test": "tsx --test tests/*.test.ts",
    "verify:http": "node tools/verify-public-http.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "htmlparser2": "12.0.0",
    "markdown-it": "15.0.3",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
