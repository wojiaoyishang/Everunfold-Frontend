{
  "name": "everunfold-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Everunfold \u7684\u72ec\u7acb Next.js \u524d\u7aef\u9879\u76ee",
  "engines": {
    "node": ">=22.15.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "extensions:check": "tsx tools/check-extensions.mts",
    "pages:manifest": "tsx tools/export-page-manifest.mts",
    "pages:register": "tsx tools/register-pages.mts",
    "failure:generate": "tsx tools/generate-failure-pages.mts",
    "failure:check": "tsx tools/generate-failure-pages.mts --check",
    "features:assets": "node tools/content-feature-assets.mjs",
    "predev": "npm run prepare:host",
    "prebuild": "npm run prepare:host",
    "dev": "tsx tools/plugins/run.mts dev",
    "build": "npm run plugins:build && next build",
    "verify:production": "node tools/verify-production.mjs",
    "verify:admin": "node tools/verify-production.mjs --admin",
    "verify:reader": "node tools/verify-production.mjs --reader",
    "start": "tsx tools/plugins/run.mts start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src tests tools .github next.config.ts eslint.config.mjs package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src tests tools .github next.config.ts eslint.config.mjs package.json tsconfig.json .prettierrc.json",
    "check": "npm run prepare:local && npm run failure:check && npm run lint && npm run typecheck && npm run plugins:typecheck && npm run format:check && npm run test",
    "contract:sync": "node tools/sync-contract.mjs",
    "test": "node --import tsx --import ./tools/extensions/node.mjs --test tests/*.test.ts",
    "verify:http": "node tools/verify-public-http.mjs",
    "settings:receiver": "tsx tools/settings-receiver.mts",
    "contracts:prepare": "node tools/prepare-contracts.mjs",
    "prepare:local": "npm run prepare:host && npm run extensions:check",
    "plugins:build": "node --import tsx tools/plugins/build.mjs",
    "plugins:typecheck": "tsc --noEmit -p tsconfig.plugins.json",
    "themes:catalog": "tsx tools/plugins/theme-catalog.mts",
    "themes:assets": "node tools/theme-assets.mjs",
    "build:host": "npm run prepare:host && next build",
    "pretest": "npm run plugins:build",
    "prepare:host": "npm run contracts:prepare && npm run failure:generate && npm run features:assets && npm run themes:catalog && npm run themes:assets",
    "extensions:register": "tsx tools/register-pages.mts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.3",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@lezer/highlight": "1.2.5",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/y-tiptap": "3.0.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "highlight.js": "11.12.0",
    "htmlparser2": "12.0.0",
    "katex": "0.19.1",
    "lib0": "0.2.119",
    "markdown-it": "15.0.3",
    "mathlive": "0.111.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-qr-code": "2.2.0",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "smol-toml": "1.9.1",
    "tsx": "4.23.15",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "react-refresh": "0.19.0",
    "typescript": "5.9.3"
  }
}
