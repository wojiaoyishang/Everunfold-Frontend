# Local dependencies and generated build state
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Local configuration and runtime state
.env
.env.*
!.env.example
config.toml
backend-node.toml
config.*.local.toml
var/
logs/
*.log
*.pid
.vercel/

# Credentials and WordPress source data must stay outside Git
*.pem
*.key
*.p12
*.pfx
*.sql
*.sql.*
*.dump
*.bak
wp-config.php
wp-content/
wordpress-backup/
public/uploads/wordpress/

# Editor / operating system state
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Installed plugin packages and all derived artifacts are local.
/plugins/
/public/themes/

# Bundled extension sources. Use separate directories for local extensions.
/src/plugins/*
!/src/plugins/.gitkeep
!/src/plugins/ai-writing/
!/src/plugins/book/
!/src/plugins/captcha/
!/src/plugins/gallery/
!/src/plugins/honors/
!/src/plugins/people/
/src/themes/*
!/src/themes/argon/
!/src/themes/paper/

# Local Sphinx output
/_build/
.venv-docs/

# Docker instance inputs
/docker/runtime.env
/docker/instance/
/docker/data/
/docker/output/
/deploy/__pycache__/
/deploy/assistant/.venv/
/docker/__pycache__/
/deploy/assistant/__pycache__/

# Project deployment configuration (contains private values)
/config.yaml
/config.yaml.*.bak

/config.runtime.toml
/config.runtime.toml.*.bak
/docker/runtime.env.docker
