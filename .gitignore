# Local dependencies and generated build state
node_modules/
.next/
out/
coverage/
*.tsbuildinfo
next-env.d.ts

# Local configuration and runtime state
.env
.env.*
!.env.example
config.toml
backend-node.toml
config.*.local.toml
var/
logs/
*.log
*.pid
.vercel/

# Credentials and WordPress source data must stay outside Git
*.pem
*.key
*.p12
*.pfx
*.sql
*.sql.*
*.dump
*.bak
wp-config.php
wp-content/
wordpress-backup/
public/uploads/wordpress/

# Editor / operating system state
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# Installed plugin packages and all derived artifacts are local.
/plugins/
/public/themes/

# Bundled extension sources. Use separate directories for local extensions.
/src/plugins/*
!/src/plugins/.gitkeep
!/src/plugins/book/
!/src/plugins/captcha/
!/src/plugins/gallery/
!/src/plugins/honors/
!/src/plugins/people/
/src/themes/*
!/src/themes/argon/
!/src/themes/paper/
